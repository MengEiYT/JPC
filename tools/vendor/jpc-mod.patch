diff -ruN a/org/jpc/emulator/execution/sse/Simd.java b/org/jpc/emulator/execution/sse/Simd.java
--- a/org/jpc/emulator/execution/sse/Simd.java	1970-01-01 07:00:00.000000000 +0700
+++ b/org/jpc/emulator/execution/sse/Simd.java	2026-11-08 23:42:43.876180615 +0700
@@ -0,0 +1,370 @@
+/*
+    JPC mod addition (not in the original JPC): lane arithmetic for MMX / SSE / SSE2.
+
+    Written for the JPC mod (GPL-2.0, like the rest of this tree). Not part of the original JPC.
+    All results follow the Intel SDM, including NaN propagation, saturation and rounding.
+*/
+
+package org.jpc.emulator.execution.sse;
+
+public final class Simd
+{
+    private Simd() {}
+
+    // ------------------------------------------------------------------ integer lanes (one 64-bit word)
+
+    public static final int ADD = 0, SUB = 1, ADDS = 2, ADDUS = 3, SUBS = 4, SUBUS = 5, EQ = 6, GT = 7,
+            MINU = 8, MAXU = 9, MINS = 10, MAXS = 11, AVG = 12, MULLO = 13, MULHS = 14, MULHU = 15;
+
+    static long sext(long v, int bits)
+    {
+        int s = 64 - bits;
+        return (v << s) >> s;
+    }
+
+    /** Applies a lane operation to every lane of a and b. bits is the lane width (8, 16, 32 or 64). */
+    public static long lanes(int kind, int bits, long a, long b)
+    {
+        final int n = 64 / bits;
+        final long mask = bits == 64 ? -1L : (1L << bits) - 1;
+        long res = 0;
+        for (int i = 0; i < n; i++)
+        {
+            int sh = i * bits;
+            long x = (a >>> sh) & mask;
+            long y = (b >>> sh) & mask;
+            long r;
+            switch (kind)
+            {
+                case ADD: r = x + y; break;
+                case SUB: r = x - y; break;
+                case ADDS:
+                {
+                    long v = sext(x, bits) + sext(y, bits);
+                    long max = (1L << (bits - 1)) - 1, min = -(1L << (bits - 1));
+                    r = v > max ? max : (v < min ? min : v);
+                    break;
+                }
+                case ADDUS:
+                {
+                    long v = x + y;
+                    r = v > mask ? mask : v;
+                    break;
+                }
+                case SUBS:
+                {
+                    long v = sext(x, bits) - sext(y, bits);
+                    long max = (1L << (bits - 1)) - 1, min = -(1L << (bits - 1));
+                    r = v > max ? max : (v < min ? min : v);
+                    break;
+                }
+                case SUBUS: r = x > y ? x - y : 0; break;
+                case EQ: r = x == y ? mask : 0; break;
+                case GT: r = sext(x, bits) > sext(y, bits) ? mask : 0; break;
+                case MINU: r = x < y ? x : y; break;
+                case MAXU: r = x > y ? x : y; break;
+                case MINS: r = sext(x, bits) < sext(y, bits) ? x : y; break;
+                case MAXS: r = sext(x, bits) > sext(y, bits) ? x : y; break;
+                case AVG: r = (x + y + 1) >>> 1; break;
+                case MULLO: r = x * y; break;
+                case MULHS: r = (sext(x, bits) * sext(y, bits)) >> 16; break;
+                case MULHU: r = (x * y) >>> 16; break;
+                default: r = 0;
+            }
+            res |= (r & mask) << sh;
+        }
+        return res;
+    }
+
+    public static long pmaddwd(long a, long b)
+    {
+        int lo = (short) a * (short) b + (short) (a >>> 16) * (short) (b >>> 16);
+        int hi = (short) (a >>> 32) * (short) (b >>> 32) + (short) (a >>> 48) * (short) (b >>> 48);
+        return (lo & 0xFFFFFFFFL) | ((long) hi << 32);
+    }
+
+    public static long pmuludq(long a, long b)
+    {
+        return (a & 0xFFFFFFFFL) * (b & 0xFFFFFFFFL);
+    }
+
+    public static long psadbw(long a, long b)
+    {
+        int s = 0;
+        for (int i = 0; i < 8; i++)
+            s += Math.abs(((int) (a >>> (8 * i)) & 0xFF) - ((int) (b >>> (8 * i)) & 0xFF));
+        return s & 0xFFFFL;
+    }
+
+    public static final int SLL = 0, SRL = 1, SRA = 2;
+
+    /** Shifts every lane of a by count (a full 64-bit unsigned count). */
+    public static long shift(int dir, int bits, long a, long count)
+    {
+        boolean big = Long.compareUnsigned(count, bits) >= 0;
+        if (bits == 64)
+        {
+            if (big)
+                return 0;
+            return dir == SLL ? a << count : a >>> count;
+        }
+        final long mask = (1L << bits) - 1;
+        final int n = 64 / bits;
+        int c = big ? bits - 1 : (int) count;
+        long res = 0;
+        for (int i = 0; i < n; i++)
+        {
+            int sh = i * bits;
+            long x = (a >>> sh) & mask;
+            long r;
+            if (dir == SLL)
+                r = big ? 0 : (x << c) & mask;
+            else if (dir == SRL)
+                r = big ? 0 : x >>> c;
+            else
+                r = (sext(x, bits) >> c) & mask;
+            res |= r << sh;
+        }
+        return res;
+    }
+
+    static int satS8(int v) { return v > 127 ? 127 : (v < -128 ? -128 : v); }
+    static int satU8(int v) { return v > 255 ? 255 : (v < 0 ? 0 : v); }
+    static int satS16(int v) { return v > 32767 ? 32767 : (v < -32768 ? -32768 : v); }
+
+    /** Four signed words to four saturated bytes (packsswb / packuswb), result in the low 32 bits. */
+    public static int pack4(long x, boolean unsigned)
+    {
+        int r = 0;
+        for (int i = 0; i < 4; i++)
+        {
+            int w = (short) (x >>> (16 * i));
+            int s = unsigned ? satU8(w) : satS8(w);
+            r |= (s & 0xFF) << (8 * i);
+        }
+        return r;
+    }
+
+    /** Two signed dwords to two saturated words (packssdw), result in the low 32 bits. */
+    public static int pack2(long x)
+    {
+        int r = 0;
+        for (int i = 0; i < 2; i++)
+        {
+            int d = (int) (x >>> (32 * i));
+            r |= (satS16(d) & 0xFFFF) << (16 * i);
+        }
+        return r;
+    }
+
+    /** Interleaves the w-byte elements of two 32-bit chunks: a0 b0 a1 b1 ... (punpck*). */
+    public static long interleave(int w, int a32, int b32)
+    {
+        int n = 4 / w;
+        long m = (1L << (8 * w)) - 1;
+        long a = a32 & 0xFFFFFFFFL, b = b32 & 0xFFFFFFFFL;
+        long r = 0;
+        for (int i = 0; i < n; i++)
+        {
+            long ea = (a >>> (8 * w * i)) & m;
+            long eb = (b >>> (8 * w * i)) & m;
+            r |= ea << (2 * i * 8 * w);
+            r |= eb << ((2 * i + 1) * 8 * w);
+        }
+        return r;
+    }
+
+    // ------------------------------------------------------------------ floating point
+
+    public static final int QNAN32 = 0xFFC00000;
+    public static final long QNAN64 = 0xFFF8000000000000L;
+    public static final int INDEFINITE = 0x80000000;
+
+    public static final int F_ADD = 0, F_SUB = 1, F_MUL = 2, F_DIV = 3, F_MIN = 4, F_MAX = 5, F_SQRT = 6, F_RCP = 7, F_RSQRT = 8;
+
+    /** Single precision operation on raw bits. Unary operations (sqrt, rcp, rsqrt) use only b. */
+    public static int fop(int kind, int a, int b)
+    {
+        float x = Float.intBitsToFloat(a);
+        float y = Float.intBitsToFloat(b);
+        switch (kind)
+        {
+            case F_MIN: return x < y ? a : b;
+            case F_MAX: return x > y ? a : b;
+            case F_SQRT:
+                if (y != y) return b | 0x400000;
+                if (y < 0) return QNAN32;
+                return Float.floatToRawIntBits((float) Math.sqrt(y));
+            case F_RCP:
+            {
+                if (y != y) return b | 0x400000;
+                // Intel: denormal inputs are treated as zero of the same sign, tiny results flush to zero
+                if ((b & 0x7F800000) == 0) y = Float.intBitsToFloat(b & 0x80000000);
+                int r = Float.floatToRawIntBits(1.0f / y);
+                if ((r & 0x7F800000) == 0) r &= 0x80000000;
+                return r;
+            }
+            case F_RSQRT:
+            {
+                if (y != y) return b | 0x400000;
+                if ((b & 0x7F800000) == 0) y = Float.intBitsToFloat(b & 0x80000000);
+                if (y < 0) return QNAN32;
+                return Float.floatToRawIntBits(1.0f / (float) Math.sqrt(y));
+            }
+            default:
+        }
+        if (x != x) return a | 0x400000;
+        if (y != y) return b | 0x400000;
+        float r;
+        switch (kind)
+        {
+            case F_ADD: r = x + y; break;
+            case F_SUB: r = x - y; break;
+            case F_MUL: r = x * y; break;
+            default: r = x / y; break;
+        }
+        return r != r ? QNAN32 : Float.floatToRawIntBits(r);
+    }
+
+    /** Double precision operation on raw bits. Unary operations use only b. */
+    public static long dop(int kind, long a, long b)
+    {
+        double x = Double.longBitsToDouble(a);
+        double y = Double.longBitsToDouble(b);
+        switch (kind)
+        {
+            case F_MIN: return x < y ? a : b;
+            case F_MAX: return x > y ? a : b;
+            case F_SQRT:
+                if (y != y) return b | 0x0008000000000000L;
+                if (y < 0) return QNAN64;
+                return Double.doubleToRawLongBits(Math.sqrt(y));
+            default:
+        }
+        if (x != x) return a | 0x0008000000000000L;
+        if (y != y) return b | 0x0008000000000000L;
+        double r;
+        switch (kind)
+        {
+            case F_ADD: r = x + y; break;
+            case F_SUB: r = x - y; break;
+            case F_MUL: r = x * y; break;
+            default: r = x / y; break;
+        }
+        return r != r ? QNAN64 : Double.doubleToRawLongBits(r);
+    }
+
+    /** cmpps/cmppd predicate (0..7). Returns true when the lane compares true. */
+    public static boolean cmpF(int pred, float x, float y)
+    {
+        switch (pred & 7)
+        {
+            case 0: return x == y;
+            case 1: return x < y;
+            case 2: return x <= y;
+            case 3: return x != x || y != y;
+            case 4: return !(x == y);
+            case 5: return !(x < y);
+            case 6: return !(x <= y);
+            default: return !(x != x || y != y);
+        }
+    }
+
+    public static boolean cmpD(int pred, double x, double y)
+    {
+        switch (pred & 7)
+        {
+            case 0: return x == y;
+            case 1: return x < y;
+            case 2: return x <= y;
+            case 3: return x != x || y != y;
+            case 4: return !(x == y);
+            case 5: return !(x < y);
+            case 6: return !(x <= y);
+            default: return !(x != x || y != y);
+        }
+    }
+
+    // ------------------------------------------------------------------ conversions
+
+    /** Rounds a double to an int32 with the given rounding control (0 even, 1 down, 2 up, 3 truncate). */
+    public static int roundInt(double v, int rc)
+    {
+        if (v != v)
+            return INDEFINITE;
+        double r;
+        switch (rc)
+        {
+            case 0: r = Math.rint(v); break;
+            case 1: r = Math.floor(v); break;
+            case 2: r = Math.ceil(v); break;
+            default: r = v < 0 ? Math.ceil(v) : Math.floor(v); break;
+        }
+        if (r >= 2147483648.0 || r < -2147483648.0)
+            return INDEFINITE;
+        return (int) r;
+    }
+
+    public static int f2i(int bits, int rc)
+    {
+        return roundInt((double) Float.intBitsToFloat(bits), rc);
+    }
+
+    public static int d2i(long bits, int rc)
+    {
+        return roundInt(Double.longBitsToDouble(bits), rc);
+    }
+
+    /** Single to double, keeping NaN payloads (signalling NaNs become quiet). */
+    public static long f2d(int a)
+    {
+        float x = Float.intBitsToFloat(a);
+        if (x != x)
+            return ((long) (a >>> 31) << 63) | 0x7FF8000000000000L | ((long) (a & 0x7FFFFF) << 29);
+        return Double.doubleToRawLongBits((double) x);
+    }
+
+    static float roundD2F(double x, int rc)
+    {
+        float f = (float) x;
+        if (rc == 0 || f != f)
+            return f;
+        double fd = f;
+        if (fd == x)
+            return f;
+        switch (rc)
+        {
+            case 1:
+                if (fd > x) f = Math.nextDown(f);
+                break;
+            case 2:
+                if (fd < x) f = Math.nextUp(f);
+                break;
+            default:
+                if (Math.abs(fd) > Math.abs(x)) f = x > 0 ? Math.nextDown(f) : Math.nextUp(f);
+                break;
+        }
+        return f;
+    }
+
+    /** Double to single with the given rounding control. */
+    public static int d2f(long a, int rc)
+    {
+        double x = Double.longBitsToDouble(a);
+        if (x != x)
+            return ((int) (a >>> 63) << 31) | 0x7FC00000 | (int) ((a & 0xFFFFFFFFFFFFFL) >>> 29);
+        return Float.floatToRawIntBits(roundD2F(x, rc));
+    }
+
+    public static int i2f(int v, int rc)
+    {
+        if (rc == 0)
+            return Float.floatToRawIntBits((float) v);
+        return Float.floatToRawIntBits(roundD2F((double) v, rc));
+    }
+
+    public static long i2d(int v)
+    {
+        return Double.doubleToRawLongBits((double) v);
+    }
+}
diff -ruN a/org/jpc/emulator/execution/sse/SseDecoder.java b/org/jpc/emulator/execution/sse/SseDecoder.java
--- a/org/jpc/emulator/execution/sse/SseDecoder.java	1970-01-01 07:00:00.000000000 +0700
+++ b/org/jpc/emulator/execution/sse/SseDecoder.java	2026-11-08 23:42:43.876161805 +0700
@@ -0,0 +1,100 @@
+/*
+    JPC mod addition (not in the original JPC): decoder for the MMX / SSE / SSE2 opcode map (two-byte 0F xx opcodes).
+
+    Written for the JPC mod (GPL-2.0, like the rest of this tree). Not part of the original JPC.
+*/
+
+package org.jpc.emulator.execution.sse;
+
+import org.jpc.emulator.execution.Executable;
+import org.jpc.emulator.execution.decoder.PeekableInputStream;
+
+public final class SseDecoder
+{
+    private SseDecoder() {}
+
+    /** Indexed by (prefix << 8) | opcode: 0 = not handled here, 1 = modrm, 2 = modrm + imm8. */
+    private static final byte[] KIND = new byte[0x400];
+
+    private static void def(int pfx, int kind, int... ops)
+    {
+        for (int o : ops)
+            KIND[pfx | o] = (byte) kind;
+    }
+
+    private static void range(int pfx, int from, int to)
+    {
+        for (int o = from; o <= to; o++)
+            KIND[pfx | o] = 1;
+    }
+
+    static
+    {
+        final int N = 0, P66 = SseOp.P66, F3 = SseOp.PF3, F2 = SseOp.PF2;
+
+        // ---- no prefix: SSE (single precision) and MMX
+        def(N, 1, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F);
+        range(N, 0x50, 0x5F);
+        range(N, 0x60, 0x6B);
+        def(N, 1, 0x6E, 0x6F, 0x74, 0x75, 0x76, 0x7E, 0x7F, 0xAE, 0xC3);
+        range(N, 0xD1, 0xD5);
+        range(N, 0xD7, 0xFE);
+        KIND[N | 0xE6] = 0;   // only exists with a prefix
+        KIND[N | 0xF0] = 0;
+        def(N, 2, 0x70, 0x71, 0x72, 0x73, 0xC2, 0xC4, 0xC5, 0xC6);
+        KIND[N | 0x52] = 1;
+        KIND[N | 0x53] = 1;
+        KIND[N | 0x5A] = 1;
+        KIND[N | 0x5B] = 1;
+
+        // ---- 66: SSE2 double precision and 128-bit integer
+        def(P66, 1, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F);
+        def(P66, 1, 0x50, 0x51);
+        range(P66, 0x54, 0x5F);
+        range(P66, 0x60, 0x6F);
+        def(P66, 1, 0x74, 0x75, 0x76, 0x7E, 0x7F);
+        range(P66, 0xD1, 0xFE);
+        KIND[P66 | 0xD0] = 0;
+        KIND[P66 | 0xF0] = 0;
+        def(P66, 2, 0x70, 0x71, 0x72, 0x73, 0xC2, 0xC4, 0xC5, 0xC6);
+
+        // ---- F3: scalar single and a few moves
+        def(F3, 1, 0x10, 0x11, 0x2A, 0x2C, 0x2D, 0x51, 0x52, 0x53, 0x58, 0x59, 0x5A, 0x5B, 0x5C, 0x5D, 0x5E, 0x5F, 0x6F, 0x7E, 0x7F, 0xD6, 0xE6);
+        def(F3, 2, 0x70, 0xC2);
+
+        // ---- F2: scalar double
+        def(F2, 1, 0x10, 0x11, 0x2A, 0x2C, 0x2D, 0x51, 0x58, 0x59, 0x5A, 0x5C, 0x5D, 0x5E, 0x5F, 0xD6, 0xE6);
+        def(F2, 2, 0x70, 0xC2);
+    }
+
+    /**
+     * Called by the main decoder after it has read 0F and the second opcode byte.
+     * Returns null when this opcode is not one of ours, so the caller can carry on as before.
+     */
+    public static Executable decode(int b2, boolean p66, boolean pF2, boolean pF3, int blockStart, int opStart, int prefices, PeekableInputStream input)
+    {
+        int pfx = pF3 ? SseOp.PF3 : pF2 ? SseOp.PF2 : p66 ? SseOp.P66 : 0;
+        int id = pfx | b2;
+
+        // JPC's generated tables only produce CMPXCHG8B (0F C7 /1) for the REPNE-prefixed form; the plain form that
+        // every 32-bit Linux kernel uses for its 64-bit atomics came out as an invalid opcode.
+        if (b2 == 0xC7)
+        {
+            int modrm = input.peek() & 0xFF;
+            if (modrm < 0xC0 && ((modrm >> 3) & 7) == 1)
+                return new org.jpc.emulator.execution.opcodes.pm.cmpxchg8b_M_mem(blockStart, opStart, prefices, input);
+            return null;
+        }
+
+        // prefetch and the hint-nop range (0F 18..1E, 0F 0D), also endbr32 (F3 0F 1E FB)
+        if (b2 == 0x0D || (b2 >= 0x18 && b2 <= 0x1E))
+            return new SseOp(blockStart, opStart, prefices, input, id, false, true);
+        if (b2 == 0x77 && pfx == 0)
+            return new SseOp(blockStart, opStart, prefices, input, id, false, false);
+
+        int kind = KIND[id];
+        if (kind == 0)
+            return null;
+        return new SseOp(blockStart, opStart, prefices, input, id, kind == 2, true);
+    }
+}
diff -ruN a/org/jpc/emulator/execution/sse/SseOp.java b/org/jpc/emulator/execution/sse/SseOp.java
--- a/org/jpc/emulator/execution/sse/SseOp.java	1970-01-01 07:00:00.000000000 +0700
+++ b/org/jpc/emulator/execution/sse/SseOp.java	2026-11-08 23:42:43.876117288 +0700
@@ -0,0 +1,1237 @@
+/*
+    JPC mod addition (not in the original JPC): MMX / SSE / SSE2 instructions.
+
+    Written for the JPC mod (GPL-2.0, like the rest of this tree). Not part of the original JPC.
+    One class executes every instruction; the opcode id is (prefix << 8) | second opcode byte,
+    where prefix 0 = none, 0x100 = 66, 0x200 = F3, 0x300 = F2.
+*/
+
+package org.jpc.emulator.execution.sse;
+
+import org.jpc.emulator.execution.Executable;
+import org.jpc.emulator.execution.decoder.Modrm;
+import org.jpc.emulator.execution.decoder.PeekableInputStream;
+import org.jpc.emulator.execution.decoder.Pointer;
+import org.jpc.emulator.execution.decoder.Prefices;
+import org.jpc.emulator.processor.Processor;
+import org.jpc.emulator.processor.ProcessorException;
+import org.jpc.emulator.processor.fpu64.FpuState64;
+
+public final class SseOp extends Executable
+{
+    public static final int P66 = 0x100, PF3 = 0x200, PF2 = 0x300;
+
+    private static final long LOW32 = 0xFFFFFFFFL;
+    private static final long HIGH32 = 0xFFFFFFFF00000000L;
+
+    final int id;
+    final int op;
+    final int pfx;
+    final int modrm;
+    final int reg;
+    final int rm;
+    final boolean isMem;
+    final Pointer mem;
+    final int imm;
+    final int segIndex;
+    /** 0: no checks, 1: x87-level checks (MMX), 2: SSE-level checks. */
+    final int check;
+
+    private long s0, s1;
+
+    public SseOp(int blockStart, int eip, int prefices, PeekableInputStream input, int id, boolean hasImm, boolean hasModrm)
+    {
+        super(blockStart, eip);
+        this.id = id;
+        this.op = id & 0xFF;
+        this.pfx = id & 0x300;
+        this.segIndex = Prefices.getSegment(prefices, Processor.DS_INDEX);
+        if (hasModrm)
+        {
+            modrm = input.readU8();
+            reg = Modrm.reg(modrm);
+            rm = Modrm.rm(modrm);
+            isMem = Modrm.isMem(modrm);
+            mem = isMem ? Modrm.getPointer(prefices, modrm, input) : null;
+        }
+        else
+        {
+            modrm = 0;
+            reg = 0;
+            rm = 0;
+            isMem = false;
+            mem = null;
+        }
+        imm = hasImm ? input.readU8() : 0;
+        check = checkKind(op, pfx);
+    }
+
+    private static int checkKind(int op, int pfx)
+    {
+        if (op == 0x0D || (op >= 0x18 && op <= 0x1E) || op == 0xAE || op == 0xC3)
+            return 0;
+        if (op == 0x77)
+            return 1;
+        if (pfx == 0 && ((op >= 0x60 && op <= 0x7F) || op == 0xC4 || op == 0xC5 || op >= 0xD0))
+            return 1;
+        return 2;
+    }
+
+    public boolean isBranch()
+    {
+        return false;
+    }
+
+    public String toString()
+    {
+        return String.format("%s[%03x]", getClass().getName(), id);
+    }
+
+    // ------------------------------------------------------------------ operand helpers
+
+    private void ld128(Processor cpu)
+    {
+        if (isMem)
+        {
+            s0 = mem.get64(cpu, 0);
+            s1 = mem.get64(cpu, 8);
+        }
+        else
+        {
+            s0 = cpu.xmm[rm << 1];
+            s1 = cpu.xmm[(rm << 1) + 1];
+        }
+    }
+
+    private long ld64(Processor cpu)
+    {
+        return isMem ? mem.get64(cpu, 0) : cpu.xmm[rm << 1];
+    }
+
+    private int ld32(Processor cpu)
+    {
+        return isMem ? mem.get32(cpu, 0) : (int) cpu.xmm[rm << 1];
+    }
+
+    private long ldMM(Processor cpu)
+    {
+        return isMem ? mem.get64(cpu, 0) : cpu.mm[rm];
+    }
+
+    private int ed(Processor cpu)
+    {
+        return isMem ? mem.get32(cpu, 0) : cpu.regs[Modrm.Ed(modrm)].get32();
+    }
+
+    private void st128(Processor cpu, long v0, long v1)
+    {
+        if (isMem)
+        {
+            mem.set64(cpu, 0, v0);
+            mem.set64(cpu, 8, v1);
+        }
+        else
+        {
+            cpu.xmm[rm << 1] = v0;
+            cpu.xmm[(rm << 1) + 1] = v1;
+        }
+    }
+
+    private static int rcOf(Processor cpu)
+    {
+        return (cpu.mxcsr >> 13) & 3;
+    }
+
+    private static void mmx(Processor cpu)
+    {
+        if (!cpu.mmxActive)
+        {
+            cpu.mmxActive = true;
+            cpu.fpu.top = 0;
+            cpu.fpu.setTagWord(0);
+        }
+    }
+
+    private static void setComis(Processor cpu, boolean un, boolean lt, boolean eq)
+    {
+        cpu.flagStatus = 0;
+        cpu.of = false;
+        cpu.sf = false;
+        cpu.af = false;
+        cpu.zf = un || eq;
+        cpu.pf = un;
+        cpu.cf = un || lt;
+    }
+
+    private static int dword(long lo, long hi, int i)
+    {
+        switch (i & 3)
+        {
+            case 0: return (int) lo;
+            case 1: return (int) (lo >>> 32);
+            case 2: return (int) hi;
+            default: return (int) (hi >>> 32);
+        }
+    }
+
+    private static long pair(int lo, int hi)
+    {
+        return (lo & LOW32) | ((long) hi << 32);
+    }
+
+    private static int arithKind(int op)
+    {
+        switch (op)
+        {
+            case 0x51: return Simd.F_SQRT;
+            case 0x52: return Simd.F_RSQRT;
+            case 0x53: return Simd.F_RCP;
+            case 0x58: return Simd.F_ADD;
+            case 0x59: return Simd.F_MUL;
+            case 0x5C: return Simd.F_SUB;
+            case 0x5D: return Simd.F_MIN;
+            case 0x5E: return Simd.F_DIV;
+            default: return Simd.F_MAX;
+        }
+    }
+
+    /** Lane-wise integer operations that apply independently to each 64-bit half. */
+    private static long lane64(int op, long a, long b)
+    {
+        switch (op)
+        {
+            case 0x64: return Simd.lanes(Simd.GT, 8, a, b);
+            case 0x65: return Simd.lanes(Simd.GT, 16, a, b);
+            case 0x66: return Simd.lanes(Simd.GT, 32, a, b);
+            case 0x74: return Simd.lanes(Simd.EQ, 8, a, b);
+            case 0x75: return Simd.lanes(Simd.EQ, 16, a, b);
+            case 0x76: return Simd.lanes(Simd.EQ, 32, a, b);
+            case 0xD4: return a + b;
+            case 0xD5: return Simd.lanes(Simd.MULLO, 16, a, b);
+            case 0xD8: return Simd.lanes(Simd.SUBUS, 8, a, b);
+            case 0xD9: return Simd.lanes(Simd.SUBUS, 16, a, b);
+            case 0xDA: return Simd.lanes(Simd.MINU, 8, a, b);
+            case 0xDB: return a & b;
+            case 0xDC: return Simd.lanes(Simd.ADDUS, 8, a, b);
+            case 0xDD: return Simd.lanes(Simd.ADDUS, 16, a, b);
+            case 0xDE: return Simd.lanes(Simd.MAXU, 8, a, b);
+            case 0xDF: return ~a & b;
+            case 0xE0: return Simd.lanes(Simd.AVG, 8, a, b);
+            case 0xE3: return Simd.lanes(Simd.AVG, 16, a, b);
+            case 0xE4: return Simd.lanes(Simd.MULHU, 16, a, b);
+            case 0xE5: return Simd.lanes(Simd.MULHS, 16, a, b);
+            case 0xE8: return Simd.lanes(Simd.SUBS, 8, a, b);
+            case 0xE9: return Simd.lanes(Simd.SUBS, 16, a, b);
+            case 0xEA: return Simd.lanes(Simd.MINS, 16, a, b);
+            case 0xEB: return a | b;
+            case 0xEC: return Simd.lanes(Simd.ADDS, 8, a, b);
+            case 0xED: return Simd.lanes(Simd.ADDS, 16, a, b);
+            case 0xEE: return Simd.lanes(Simd.MAXS, 16, a, b);
+            case 0xEF: return a ^ b;
+            case 0xF4: return Simd.pmuludq(a, b);
+            case 0xF5: return Simd.pmaddwd(a, b);
+            case 0xF6: return Simd.psadbw(a, b);
+            case 0xF8: return Simd.lanes(Simd.SUB, 8, a, b);
+            case 0xF9: return Simd.lanes(Simd.SUB, 16, a, b);
+            case 0xFA: return Simd.lanes(Simd.SUB, 32, a, b);
+            case 0xFB: return a - b;
+            case 0xFC: return Simd.lanes(Simd.ADD, 8, a, b);
+            case 0xFD: return Simd.lanes(Simd.ADD, 16, a, b);
+            case 0xFE: return Simd.lanes(Simd.ADD, 32, a, b);
+            default: throw ProcessorException.UNDEFINED;
+        }
+    }
+
+    private static boolean isLane64(int op)
+    {
+        switch (op)
+        {
+            case 0x64: case 0x65: case 0x66: case 0x74: case 0x75: case 0x76:
+            case 0xD4: case 0xD5: case 0xD8: case 0xD9: case 0xDA: case 0xDB: case 0xDC: case 0xDD: case 0xDE: case 0xDF:
+            case 0xE0: case 0xE3: case 0xE4: case 0xE5: case 0xE8: case 0xE9: case 0xEA: case 0xEB: case 0xEC: case 0xED: case 0xEE: case 0xEF:
+            case 0xF4: case 0xF5: case 0xF6: case 0xF8: case 0xF9: case 0xFA: case 0xFB: case 0xFC: case 0xFD: case 0xFE:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private static boolean isShift(int op)
+    {
+        switch (op)
+        {
+            case 0xD1: case 0xD2: case 0xD3: case 0xE1: case 0xE2: case 0xF1: case 0xF2: case 0xF3:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private static long shiftOp(int op, long a, long count)
+    {
+        switch (op)
+        {
+            case 0xD1: return Simd.shift(Simd.SRL, 16, a, count);
+            case 0xD2: return Simd.shift(Simd.SRL, 32, a, count);
+            case 0xD3: return Simd.shift(Simd.SRL, 64, a, count);
+            case 0xE1: return Simd.shift(Simd.SRA, 16, a, count);
+            case 0xE2: return Simd.shift(Simd.SRA, 32, a, count);
+            case 0xF1: return Simd.shift(Simd.SLL, 16, a, count);
+            case 0xF2: return Simd.shift(Simd.SLL, 32, a, count);
+            default: return Simd.shift(Simd.SLL, 64, a, count);
+        }
+    }
+
+    private static int unpackWidth(int op)
+    {
+        switch (op)
+        {
+            case 0x60: case 0x68: return 1;
+            case 0x61: case 0x69: return 2;
+            default: return 4;
+        }
+    }
+
+    // ------------------------------------------------------------------ execution
+
+    public Branch execute(Processor cpu)
+    {
+        if (check != 0)
+        {
+            int cr0 = cpu.getCR0();
+            if ((cr0 & Processor.CR0_FPU_EMULATION) != 0)
+                throw ProcessorException.UNDEFINED;
+            if (check == 2 && (cpu.getCR4() & Processor.CR4_OS_SUPPORT_FXSAVE_FXSTORE) == 0)
+                throw ProcessorException.UNDEFINED;
+            if ((cr0 & Processor.CR0_TASK_SWITCHED) != 0)
+                throw ProcessorException.NO_FPU;
+        }
+
+        final long[] x = cpu.xmm;
+        final int d = reg << 1;
+        final int r = rm << 1;
+
+        switch (op)
+        {
+            // ---- no operation: prefetch, hint nops (endbr32 and friends)
+            case 0x0D: case 0x18: case 0x19: case 0x1A: case 0x1B: case 0x1C: case 0x1D: case 0x1E:
+                break;
+
+            case 0x77: // emms
+                cpu.mmxActive = false;
+                cpu.fpu.setTagWord(0xFFFF);
+                break;
+
+            // ---- moves
+            case 0x10:
+                if (pfx == 0 || pfx == P66)
+                {
+                    ld128(cpu);
+                    x[d] = s0;
+                    x[d + 1] = s1;
+                }
+                else if (pfx == PF3)
+                {
+                    if (isMem)
+                    {
+                        x[d] = mem.get32(cpu, 0) & LOW32;
+                        x[d + 1] = 0;
+                    }
+                    else
+                        x[d] = (x[d] & HIGH32) | (x[r] & LOW32);
+                }
+                else
+                {
+                    if (isMem)
+                    {
+                        x[d] = mem.get64(cpu, 0);
+                        x[d + 1] = 0;
+                    }
+                    else
+                        x[d] = x[r];
+                }
+                break;
+            case 0x11:
+                if (pfx == 0 || pfx == P66)
+                    st128(cpu, x[d], x[d + 1]);
+                else if (pfx == PF3)
+                {
+                    if (isMem)
+                        mem.set32(cpu, 0, (int) x[d]);
+                    else
+                        x[r] = (x[r] & HIGH32) | (x[d] & LOW32);
+                }
+                else
+                {
+                    if (isMem)
+                        mem.set64(cpu, 0, x[d]);
+                    else
+                        x[r] = x[d];
+                }
+                break;
+            case 0x12:
+                if (isMem)
+                    x[d] = mem.get64(cpu, 0);
+                else if (pfx == 0)
+                    x[d] = x[r + 1];
+                else
+                    throw ProcessorException.UNDEFINED;
+                break;
+            case 0x13:
+                if (!isMem)
+                    throw ProcessorException.UNDEFINED;
+                mem.set64(cpu, 0, x[d]);
+                break;
+            case 0x14:
+            {
+                ld128(cpu);
+                long d0 = x[d];
+                if (pfx == 0)
+                {
+                    x[d] = (d0 & LOW32) | (s0 << 32);
+                    x[d + 1] = (d0 >>> 32) | (s0 & HIGH32);
+                }
+                else
+                    x[d + 1] = s0;
+                break;
+            }
+            case 0x15:
+            {
+                ld128(cpu);
+                long d1 = x[d + 1];
+                if (pfx == 0)
+                {
+                    x[d] = (d1 & LOW32) | (s1 << 32);
+                    x[d + 1] = (d1 >>> 32) | (s1 & HIGH32);
+                }
+                else
+                {
+                    x[d] = d1;
+                    x[d + 1] = s1;
+                }
+                break;
+            }
+            case 0x16:
+                if (isMem)
+                    x[d + 1] = mem.get64(cpu, 0);
+                else if (pfx == 0)
+                    x[d + 1] = x[r];
+                else
+                    throw ProcessorException.UNDEFINED;
+                break;
+            case 0x17:
+                if (!isMem)
+                    throw ProcessorException.UNDEFINED;
+                mem.set64(cpu, 0, x[d + 1]);
+                break;
+            case 0x28:
+                ld128(cpu);
+                x[d] = s0;
+                x[d + 1] = s1;
+                break;
+            case 0x29:
+                st128(cpu, x[d], x[d + 1]);
+                break;
+            case 0x2B:
+                if (!isMem)
+                    throw ProcessorException.UNDEFINED;
+                st128(cpu, x[d], x[d + 1]);
+                break;
+
+            // ---- conversions between integers and floating point
+            case 0x2A:
+            {
+                int rc = rcOf(cpu);
+                switch (pfx)
+                {
+                    case 0:
+                    {
+                        mmx(cpu);
+                        long src = ldMM(cpu);
+                        x[d] = pair(Simd.i2f((int) src, rc), Simd.i2f((int) (src >>> 32), rc));
+                        break;
+                    }
+                    case PF3:
+                        x[d] = (x[d] & HIGH32) | (Simd.i2f(ed(cpu), rc) & LOW32);
+                        break;
+                    case P66:
+                    {
+                        mmx(cpu);
+                        long src = ldMM(cpu);
+                        x[d] = Simd.i2d((int) src);
+                        x[d + 1] = Simd.i2d((int) (src >>> 32));
+                        break;
+                    }
+                    default:
+                        x[d] = Simd.i2d(ed(cpu));
+                        break;
+                }
+                break;
+            }
+            case 0x2C:
+            case 0x2D:
+            {
+                int rc = op == 0x2C ? 3 : rcOf(cpu);
+                switch (pfx)
+                {
+                    case 0:
+                    {
+                        mmx(cpu);
+                        long src = isMem ? mem.get64(cpu, 0) : x[r];
+                        cpu.mm[reg] = pair(Simd.f2i((int) src, rc), Simd.f2i((int) (src >>> 32), rc));
+                        break;
+                    }
+                    case P66:
+                        mmx(cpu);
+                        ld128(cpu);
+                        cpu.mm[reg] = pair(Simd.d2i(s0, rc), Simd.d2i(s1, rc));
+                        break;
+                    case PF3:
+                        cpu.regs[Modrm.Gd(modrm)].set32(Simd.f2i(ld32(cpu), rc));
+                        break;
+                    default:
+                        cpu.regs[Modrm.Gd(modrm)].set32(Simd.d2i(ld64(cpu), rc));
+                        break;
+                }
+                break;
+            }
+            case 0x2E:
+            case 0x2F:
+            {
+                double a, b;
+                if (pfx == 0)
+                {
+                    a = Float.intBitsToFloat((int) x[d]);
+                    b = Float.intBitsToFloat(ld32(cpu));
+                }
+                else
+                {
+                    a = Double.longBitsToDouble(x[d]);
+                    b = Double.longBitsToDouble(ld64(cpu));
+                }
+                setComis(cpu, a != a || b != b, a < b, a == b);
+                break;
+            }
+            case 0x50:
+            {
+                if (isMem)
+                    throw ProcessorException.UNDEFINED;
+                int v;
+                if (pfx == 0)
+                    v = (int) ((x[r] >>> 31) & 1) | (int) (((x[r] >>> 63) & 1) << 1) | (int) (((x[r + 1] >>> 31) & 1) << 2) | (int) (((x[r + 1] >>> 63) & 1) << 3);
+                else
+                    v = (int) (x[r] >>> 63) | (int) ((x[r + 1] >>> 63) << 1);
+                cpu.regs[Modrm.Gd(modrm)].set32(v);
+                break;
+            }
+
+            // ---- floating point arithmetic
+            case 0x51: case 0x52: case 0x53: case 0x58: case 0x59: case 0x5C: case 0x5D: case 0x5E: case 0x5F:
+            {
+                int kind = arithKind(op);
+                switch (pfx)
+                {
+                    case 0:
+                    {
+                        ld128(cpu);
+                        long a0 = x[d], a1 = x[d + 1];
+                        x[d] = pair(Simd.fop(kind, (int) a0, (int) s0), Simd.fop(kind, (int) (a0 >>> 32), (int) (s0 >>> 32)));
+                        x[d + 1] = pair(Simd.fop(kind, (int) a1, (int) s1), Simd.fop(kind, (int) (a1 >>> 32), (int) (s1 >>> 32)));
+                        break;
+                    }
+                    case PF3:
+                    {
+                        int s = ld32(cpu);
+                        x[d] = (x[d] & HIGH32) | (Simd.fop(kind, (int) x[d], s) & LOW32);
+                        break;
+                    }
+                    case P66:
+                        ld128(cpu);
+                        x[d] = Simd.dop(kind, x[d], s0);
+                        x[d + 1] = Simd.dop(kind, x[d + 1], s1);
+                        break;
+                    default:
+                        x[d] = Simd.dop(kind, x[d], ld64(cpu));
+                        break;
+                }
+                break;
+            }
+            case 0x54:
+                ld128(cpu);
+                x[d] &= s0;
+                x[d + 1] &= s1;
+                break;
+            case 0x55:
+                ld128(cpu);
+                x[d] = ~x[d] & s0;
+                x[d + 1] = ~x[d + 1] & s1;
+                break;
+            case 0x56:
+                ld128(cpu);
+                x[d] |= s0;
+                x[d + 1] |= s1;
+                break;
+            case 0x57:
+                ld128(cpu);
+                x[d] ^= s0;
+                x[d + 1] ^= s1;
+                break;
+            case 0x5A:
+            {
+                int rc = rcOf(cpu);
+                switch (pfx)
+                {
+                    case 0:
+                    {
+                        long src = isMem ? mem.get64(cpu, 0) : x[r];
+                        x[d] = Simd.f2d((int) src);
+                        x[d + 1] = Simd.f2d((int) (src >>> 32));
+                        break;
+                    }
+                    case P66:
+                        ld128(cpu);
+                        x[d] = pair(Simd.d2f(s0, rc), Simd.d2f(s1, rc));
+                        x[d + 1] = 0;
+                        break;
+                    case PF3:
