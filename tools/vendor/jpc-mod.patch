-        if (op1.get32() == 0)
+        int divisor = op1.get32();
+        if (divisor == 0)
             throw ProcessorException.DIVIDE_ERROR;
-        long ldiv = ((0xffffffffL & cpu.r_edx.get32()) << 32 ) | (0xffffffffL & cpu.r_eax.get32());
